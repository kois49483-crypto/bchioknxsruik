package com.myra.assistant.ai

import android.annotation.SuppressLint
import android.media.AudioAttributes
import android.media.AudioFormat
import android.media.AudioManager
import android.media.AudioRecord
import android.media.AudioTrack
import android.media.MediaRecorder
import android.util.Log
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.atomic.AtomicBoolean
import kotlin.math.sqrt

/**
 * PCM Native Audio Engine
 * MIC:  16000 Hz Mono 16-bit -> WebSocket
 * SPK:  24000 Hz Mono 16-bit <- WebSocket (queue-based)
 */
class AudioEngine {

    companion object {
        private const val TAG = "AudioEngine"
        const val SAMPLE_RATE_IN = 16000
        const val SAMPLE_RATE_OUT = 24000
        private const val CHUNK_SIZE = 1024
        private const val SILENCE_CYCLES_TO_STOP = 15
    }

    var onMicAudio: ((ByteArray) -> Unit)? = null
    var onAmplitudeChanged: ((Float) -> Unit)? = null
    var onSpeakingStarted: (() -> Unit)? = null
    var onSpeakingStopped: (() -> Unit)? = null

    private var audioRecord: AudioRecord? = null
    private var audioTrack: AudioTrack? = null
    private val playbackQueue = ConcurrentLinkedQueue<ByteArray>()
    private val isRecording = AtomicBoolean(false)
    private val isPlaybackLoopRunning = AtomicBoolean(false)

    @Volatile var isMuted = false
    @Volatile var isMicSuppressed = false

    var isSpeaking = false
        private set

    // ============ MIC (16kHz) ============

    @SuppressLint("MissingPermission")
    fun startRecording() {
        if (isRecording.get()) return
        val minBuf = AudioRecord.getMinBufferSize(
            SAMPLE_RATE_IN, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT
        )
        audioRecord = AudioRecord(
            MediaRecorder.AudioSource.VOICE_RECOGNITION,
            SAMPLE_RATE_IN,
            AudioFormat.CHANNEL_IN_MONO,
            AudioFormat.ENCODING_PCM_16BIT,
            maxOf(minBuf, CHUNK_SIZE * 4)
        )
        isRecording.set(true)

        Thread {
            try {
                audioRecord?.startRecording()
                val buffer = ByteArray(CHUNK_SIZE)
                while (isRecording.get()) {
                    val read = audioRecord?.read(buffer, 0, CHUNK_SIZE) ?: -1
                    if (read > 0) {
                        val chunk = buffer.copyOf(read)
                        onAmplitudeChanged?.invoke(computeRms(chunk))
                        // Speaking/muted/call-mode -> mic suppress (echo fix)
                        if (!isMuted && !isMicSuppressed && !isSpeaking) {
                            onMicAudio?.invoke(chunk)
                        }
                    }
                }
                audioRecord?.stop()
            } catch (e: Exception) {
                Log.e(TAG, "Record error: ${e.message}")
            }
        }.start()
    }

    private fun computeRms(pcm: ByteArray): Float {
        var sum = 0.0
        var i = 0
        while (i + 1 < pcm.size) {
            val sample = ((pcm[i + 1].toInt() shl 8) or (pcm[i].toInt() and 0xFF)).toShort()
            sum += sample.toDouble() * sample
            i += 2
        }
        val rms = sqrt(sum / (pcm.size / 2.0))
        return (rms / 32768.0).toFloat().coerceIn(0f, 1f)
    }

    // ============ SPEAKER (24kHz, queue) ============

    fun startPlayback() {
        if (isPlaybackLoopRunning.get()) return
        val minBuf = AudioTrack.getMinBufferSize(
            SAMPLE_RATE_OUT, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT
        )
        audioTrack = AudioTrack(
            AudioAttributes.Builder()
                .setUsage(AudioAttributes.USAGE_ASSISTANT)
                .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
                .build(),
            AudioFormat.Builder()
                .setSampleRate(SAMPLE_RATE_OUT)
                .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
                .build(),
            maxOf(minBuf, 8192),
            AudioTrack.MODE_STREAM,
            AudioManager.AUDIO_SESSION_ID_GENERATE
        )
        isPlaybackLoopRunning.set(true)

        Thread {
            try {
                audioTrack?.play()
                var emptyCycles = 0
                while (isPlaybackLoopRunning.get()) {
                    val chunk = playbackQueue.poll()
                    if (chunk == null) {
                        if (isSpeaking && ++emptyCycles > SILENCE_CYCLES_TO_STOP) {
                            isSpeaking = false
                            emptyCycles = 0
                            onSpeakingStopped?.invoke()
                        }
                        Thread.sleep(20)
                        continue
                    }
                    emptyCycles = 0
                    if (!isSpeaking) {
                        isSpeaking = true
                        onSpeakingStarted?.invoke()
                    }
                    audioTrack?.write(chunk, 0, chunk.size, AudioTrack.WRITE_BLOCKING)
                }
                audioTrack?.stop()
            } catch (e: Exception) {
                Log.e(TAG, "Playback error: ${e.message}")
            }
        }.start()
    }

    fun queueAudio(pcm: ByteArray) {
        playbackQueue.offer(pcm)
    }

    fun interruptPlayback() {
        playbackQueue.clear()
        try {
            audioTrack?.pause()
            audioTrack?.flush()
            audioTrack?.play()
        } catch (_: Exception) {}
        if (isSpeaking) {
            isSpeaking = false
            onSpeakingStopped?.invoke()
        }
    }

    fun setMuted(muted: Boolean) {
        isMuted = muted
    }

    fun release() {
        isRecording.set(false)
        isPlaybackLoopRunning.set(false)
        playbackQueue.clear()
        try { audioRecord?.release() } catch (_: Exception) {}
        try { audioTrack?.release() } catch (_: Exception) {}
        audioRecord = null
        audioTrack = null
    }
}
''')

