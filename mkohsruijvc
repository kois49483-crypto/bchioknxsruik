package com.myra.assistant.service

import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.content.pm.ServiceInfo
import android.os.Build
import android.os.IBinder
import android.provider.ContactsContract
import android.telephony.PhoneStateListener
import android.telephony.TelephonyManager
import android.util.Log
import androidx.core.app.NotificationCompat
import androidx.core.content.ContextCompat
import com.myra.assistant.R
import com.myra.assistant.ui.main.MainActivity

class CallMonitorService : Service() {

    companion object {
        private const val TAG = "CallMonitorService"
        private const val CHANNEL_ID = "myra_call_channel"
        private const val NOTIF_ID = 2001
    }

    private var telephonyManager: TelephonyManager? = null
    private var listener: PhoneStateListener? = null
    private var powerRegistered = false
    private val powerReceiver = PowerButtonReceiver()

    override fun onCreate() {
        super.onCreate()
        startForegroundWithNotification()
        registerCallListener()
        registerPowerReceiver()
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int = START_STICKY

    private fun startForegroundWithNotification() {
        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            nm.createNotificationChannel(
                NotificationChannel(CHANNEL_ID, "MYRA Call Monitor", NotificationManager.IMPORTANCE_LOW)
            )
        }
        val notification = NotificationCompat.Builder(this, CHANNEL_ID)
            .setSmallIcon(R.drawable.ic_myra_notif)
            .setContentTitle("MYRA Active")
            .setContentText("Call monitoring on hai")
            .setOngoing(true)
            .build()

        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                startForeground(NOTIF_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_PHONE_CALL)
            } else startForeground(NOTIF_ID, notification)
        } catch (e: Exception) {
            Log.e(TAG, "FGS type failed, fallback: ${e.message}")
            startForeground(NOTIF_ID, notification)
        }
    }

    @Suppress("MissingPermission")
    private fun registerCallListener() {
        try {
            telephonyManager = getSystemService(Context.TELEPHONY_SERVICE) as TelephonyManager
            listener = object : PhoneStateListener() {
                override fun onCallStateChanged(state: Int, phoneNumber: String?) {
                    when (state) {
                        TelephonyManager.CALL_STATE_RINGING -> {
                            val name = resolveCallerName(phoneNumber ?: "Unknown")
                            Log.d(TAG, "RINGING: $name")
                            launchMainActivityWithCall(name)
                        }
                        TelephonyManager.CALL_STATE_IDLE -> sendCallEndedBroadcast()
                        TelephonyManager.CALL_STATE_OFFHOOK -> { /* call active */ }
                    }
                }
            }
            telephonyManager?.listen(listener, PhoneStateListener.LISTEN_CALL_STATE)
        } catch (e: Exception) {
            Log.e(TAG, "Call listener failed: ${e.message}")
        }
    }

    private fun resolveCallerName(number: String): String {
        if (number.isBlank() || number == "Unknown") return "Unknown number"
        val digits = number.filter { it.isDigit() }
        if (digits.length < 7) return number
        val lastDigits = digits.takeLast(7)
        try {
            contentResolver.query(
                ContactsContract.CommonDataKinds.Phone.CONTENT_URI,
                arrayOf(
                    ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME,
                    ContactsContract.CommonDataKinds.Phone.NUMBER
                ), null, null, null
            )?.use { cursor ->
                val nameIdx = cursor.getColumnIndex(ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME)
                val numIdx = cursor.getColumnIndex(ContactsContract.CommonDataKinds.Phone.NUMBER)
                while (cursor.moveToNext()) {
                    val contactDigits = cursor.getString(numIdx)?.filter { it.isDigit() } ?: continue
                    if (contactDigits.endsWith(lastDigits)) {
                        return cursor.getString(nameIdx) ?: number
                    }
                }
            }
        } catch (_: SecurityException) {}
        return number
    }

    private fun launchMainActivityWithCall(callerName: String) {
        val intent = Intent(this, MainActivity::class.java).apply {
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
            putExtra(MainActivity.EXTRA_INCOMING_CALL, true)
            putExtra(MainActivity.EXTRA_CALLER_NAME, callerName)
        }
        try { startActivity(intent) } catch (e: Exception) {
            Log.e(TAG, "Background launch blocked: ${e.message}")
        }
    }

    private fun sendCallEndedBroadcast() {
        sendBroadcast(Intent(MainActivity.ACTION_CALL_ENDED).setPackage(packageName))
    }

    private fun registerPowerReceiver() {
        if (powerRegistered) return
        val filter = IntentFilter().apply {
            addAction(Intent.ACTION_SCREEN_OFF)
            addAction(Intent.ACTION_SCREEN_ON)
        }
        ContextCompat.registerReceiver(this, powerReceiver, filter, ContextCompat.RECEIVER_NOT_EXPORTED)
        powerRegistered = true
    }

    override fun onDestroy() {
        telephonyManager?.listen(listener, PhoneStateListener.LISTEN_NONE)
        if (powerRegistered) unregisterReceiver(powerReceiver)
        super.onDestroy()
    }

    override fun onBind(intent: Intent?): IBinder? = null
}
