class SettingsActivity : AppCompatActivity() {

    companion object {
        private const val PREFS = "myra_prefs"
    }

    private lateinit var viewModel: MainViewModel
    private lateinit var primeAdapter: PrimeContactAdapter

    private lateinit var apiKeyInput: EditText
    private lateinit var userNameInput: EditText
    private lateinit var modelSpinner: Spinner
    private lateinit var voiceSpinner: Spinner
    private lateinit var radioGf: RadioButton
    private lateinit var radioProfessional: RadioButton
    private lateinit var radioAssistant: RadioButton
    private lateinit var primeRecycler: RecyclerView
    private lateinit var accessibilityStatus: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_settings)

        viewModel = ViewModelProvider(this)[MainViewModel::class.java]

        apiKeyInput = findViewById(R.id.apiKeyInput)
        userNameInput = findViewById(R.id.userNameInput)
        modelSpinner = findViewById(R.id.modelSpinner)
        voiceSpinner = findViewById(R.id.voiceSpinner)
        radioGf = findViewById(R.id.radioGf)
        radioProfessional = findViewById(R.id.radioProfessional)
        radioAssistant = findViewById(R.id.radioAssistant)
        primeRecycler = findViewById(R.id.primeRecycler)
        accessibilityStatus = findViewById(R.id.accessibilityStatus)

        loadSavedPrefs()
        setupPrimeContacts()

        findViewById<TextView>(R.id.addPrimeBtn).setOnClickListener { showAddContactDialog() }
        accessibilityStatus.setOnClickListener {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        }
        findViewById<TextView>(R.id.saveBtn).setOnClickListener { saveAll() }
        findViewById<View>(R.id.backBtn).setOnClickListener { finish() }
    }

    override fun onResume() {
        super.onResume()
        updateAccessibilityStatus()
    }

    private fun loadSavedPrefs() {
        val prefs = getSharedPreferences(PREFS, MODE_PRIVATE)
        apiKeyInput.setText(prefs.getString("api_key", ""))
        userNameInput.setText(prefs.getString("user_name", ""))

        val modelLabels = GeminiLiveClient.MODELS.map { it.first }
        modelSpinner.adapter = ArrayAdapter(
            this, android.R.layout.simple_spinner_dropdown_item, modelLabels
        )
        val savedModel = prefs.getString("gemini_model", GeminiLiveClient.DEFAULT_MODEL)
        val modelIdx = GeminiLiveClient.MODELS.indexOfFirst { it.second == savedModel }
        if (modelIdx >= 0) modelSpinner.setSelection(modelIdx)

        voiceSpinner.adapter = ArrayAdapter(
            this, android.R.layout.simple_spinner_dropdown_item, GeminiLiveClient.VOICES
        )
        val savedVoice = prefs.getString("gemini_voice", GeminiLiveClient.DEFAULT_VOICE) ?: "Aoede"
        val voiceIdx = GeminiLiveClient.VOICES.indexOf(savedVoice)
        if (voiceIdx >= 0) voiceSpinner.setSelection(voiceIdx)

        when (prefs.getString("personality_mode", "gf")) {
            "professional" -> radioProfessional.isChecked = true
            "assistant" -> radioAssistant.isChecked = true
            else -> radioGf.isChecked = true
        }
    }

    private fun setupPrimeContacts() {
        primeAdapter = PrimeContactAdapter(viewModel.getPrimeContacts()) { position ->
            viewModel.removePrimeContact(position)
            refreshPrimeContacts()
        }
        primeRecycler.layoutManager = LinearLayoutManager(this)
        primeRecycler.adapter = primeAdapter
    }

    private fun refreshPrimeContacts() = primeAdapter.refresh(viewModel.getPrimeContacts())

    private fun showAddContactDialog() {
        val dialogView = layoutInflater.inflate(R.layout.dialog_add_prime_contact, null)
        val nameInput = dialogView.findViewById<EditText>(R.id.dialogNameInput)
        val numberInput = dialogView.findViewById<EditText>(R.id.dialogNumberInput)

        AlertDialog.Builder(this)
            .setTitle("Add Prime Contact")
            .setView(dialogView)
            .setPositiveButton("ADD") { _, _ ->
                viewModel.addPrimeContact(nameInput.text.toString(), numberInput.text.toString())
                refreshPrimeContacts()
                Toast.makeText(this, "Contact added", Toast.LENGTH_SHORT).show()
            }
            .setNegativeButton("Cancel", null)
            .show()
    }

    private fun updateAccessibilityStatus() {
        val enabled = AccessibilityHelperService.isEnabled()
        accessibilityStatus.text = if (enabled)
            "Accessibility ON - full control enabled"
        else
            "Accessibility OFF - tap to enable"
        accessibilityStatus.setTextColor(
            getColor(if (enabled) R.color.myra_success else R.color.myra_red)
        )
    }

    private fun saveAll() {
        val model = GeminiLiveClient.MODELS.getOrNull(modelSpinner.selectedItemPosition)?.second
            ?: GeminiLiveClient.DEFAULT_MODEL
        val voice = GeminiLiveClient.VOICES.getOrNull(voiceSpinner.selectedItemPosition) ?: "Aoede"
        val personality = when {
            radioProfessional.isChecked -> "professional"
            radioAssistant.isChecked -> "assistant"
            else -> "gf"
        }

        getSharedPreferences(PREFS, MODE_PRIVATE).edit()
            .putString("api_key", apiKeyInput.text.toString().trim())
            .putString("user_name", userNameInput.text.toString().trim())
            .putString("gemini_model", model)
            .putString("gemini_voice", voice)
            .putString("personality_mode", personality)
            .apply()

        Toast.makeText(this, "Saved - Restart app to apply changes", Toast.LENGTH_LONG).show()
        finish()
    }
}

class PrimeContactAdapter(
    private var contacts: List<PrimeContact>,
    private val onDelete: (Int) -> Unit
) : RecyclerView.Adapter<PrimeContactAdapter.PrimeVH>() {

    class PrimeVH(v: View) : RecyclerView.ViewHolder(v) {
        val name: TextView = v.findViewById(R.id.primeItemName)
        val number: TextView = v.findViewById(R.id.primeItemNumber)
        val delete: ImageButton = v.findViewById(R.id.primeItemDelete)
    }

    fun refresh(newList: List<PrimeContact>) {
        contacts = newList
        notifyDataSetChanged()
    }

    override fun getItemCount() = contacts.size

    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): PrimeVH {
        val view = LayoutInflater.from(parent.context)
            .inflate(R.layout.item_prime_contact, parent, false)
        return PrimeVH(view)
    }

    override fun onBindViewHolder(holder: PrimeVH, position: Int) {
        val contact = contacts[position]
        holder.name.text = contact.name
        holder.number.text = contact.number
        holder.delete.setOnClickListener { onDelete(holder.bindingAdapterPosition) }
    }
}
''')

