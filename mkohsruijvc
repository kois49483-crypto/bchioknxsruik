// ============ WAVEFORM (20 bars, lerp) ============

class WaveformView @JvmOverloads constructor(
    context: Context, attrs: AttributeSet? = null, defStyleAttr: Int = 0
) : View(context, attrs, defStyleAttr) {

    companion object {
        private const val BAR_COUNT = 20
        private const val BAR_COLOR = 0xFFFF1744.toInt()
    }

    private val barHeights = FloatArray(BAR_COUNT) { 0.08f }
    private var amplitude = 0f
    private var running = false
    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = BAR_COLOR }

    fun setAmplitude(rms: Float) { amplitude = rms.coerceIn(0f, 1f) }

    fun startAnimation() {
        if (running) return
        running = true
        postInvalidateOnAnimation()
    }

    fun stopAnimation() { running = false }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val now = System.currentTimeMillis()
        val step = width.toFloat() / BAR_COUNT
        val barWidth = step * 0.55f
        val midY = height / 2f

        for (i in 0 until BAR_COUNT) {
            val wave = (sin(now / 160.0 + i * 0.55) * 0.5 + 0.5).toFloat()
            val target = (0.12f + amplitude * 0.88f) * (0.3f + 0.7f * wave)
            barHeights[i] += (target - barHeights[i]) * 0.3f

            val h = (barHeights[i] * height * 0.9f).coerceAtLeast(4f)
            paint.alpha = (150 + 105 * barHeights[i]).toInt().coerceIn(0, 255)
            val left = i * step + (step - barWidth) / 2f
            canvas.drawRoundRect(
                left, midY - h / 2f, left + barWidth, midY + h / 2f,
                barWidth / 2f, barWidth / 2f, paint
            )
        }
        if (running) postInvalidateOnAnimation()
    }
}
