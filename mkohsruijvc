            val intent = Intent(Intent.ACTION_CALL, Uri.parse("tel:${number.replace(" ", "")}"))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ctx.startActivity(intent)
            okMsg
        } catch (e: SecurityException) {
