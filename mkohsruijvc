package com.myra.assistant.ui.main

import android.animation.ValueAnimator
import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.DashPathEffect
import android.graphics.Paint
import android.graphics.RadialGradient
import android.graphics.Shader
import android.util.AttributeSet
import android.view.View
import android.view.animation.LinearInterpolator
import androidx.core.graphics.ColorUtils
import kotlin.math.min
import kotlin.math.sin

class OrbAnimationView @JvmOverloads constructor(
    context: Context, attrs: AttributeSet? = null, defStyleAttr: Int = 0
) : View(context, attrs, defStyleAttr) {

    enum class State { IDLE, LISTENING, SPEAKING, THINKING }

    private var state = State.IDLE
    private var rotationAngle = 0f
    private var waveOffset = 0f
    private var thinkingAngle = 0f
    private var pulsePhase = 0f
    private var amplitude = 0f
    private val density = resources.displayMetrics.density

    private val glowPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val corePaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val ringPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        pathEffect = DashPathEffect(floatArrayOf(18f, 12f), 0f)
    }
    private val wavePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
    private val arcPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        style = Paint.Style.STROKE
        strokeCap = Paint.Cap.ROUND
    }
    private val particlePaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val highlightPaint = Paint(Paint.ANTI_ALIAS_FLAG)

    private val palettes = mapOf(
        State.IDLE to (0xFFB71C1C.toInt() to 0xFF880E4F.toInt()),
        State.LISTENING to (0xFFFF1744.toInt() to 0xFFD500F9.toInt()),
        State.SPEAKING to (0xFFE040FB.toInt() to 0xFFFF1744.toInt()),
        State.THINKING to (0xFF40C4FF.toInt() to 0xFF00B0FF.toInt())
    )

    private class Particle(var angle: Float, val radiusFactor: Float, val speed: Float, val size: Float)
    private val particles: List<Particle> = (0 until 12).map { i ->
        Particle(
            angle = i * 30f,
            radiusFactor = 1.35f + (i % 3) * 0.25f,
            speed = if (i % 2 == 0) 1f else -1f,
            size = 2.2f + (i % 4) * 0.9f
        )
    }

    private val rotationAnimator = ValueAnimator.ofFloat(0f, 360f).apply {
        duration = 9000L; repeatCount = ValueAnimator.INFINITE; interpolator = LinearInterpolator()
        addUpdateListener { rotationAngle = it.animatedValue as Float; invalidate() }
    }
    private val waveAnimator = ValueAnimator.ofFloat(0f, (2 * Math.PI).toFloat()).apply {
        duration = 1200L; repeatCount = ValueAnimator.INFINITE; interpolator = LinearInterpolator()
        addUpdateListener { waveOffset = it.animatedValue as Float; invalidate() }
    }
    val thinkingAnimator = ValueAnimator.ofFloat(0f, 360f).apply {
        duration = 900L; repeatCount = ValueAnimator.INFINITE; interpolator = LinearInterpolator()
        addUpdateListener { thinkingAngle = it.animatedValue as Float; invalidate() }
    }
    private val pulseAnimator = ValueAnimator.ofFloat(0f, (2 * Math.PI).toFloat()).apply {
        duration = 1500L; repeatCount = ValueAnimator.INFINITE; interpolator = LinearInterpolator()
        addUpdateListener { pulsePhase = it.animatedValue as Float; invalidate() }
    }

    init {
        listOf(rotationAnimator, waveAnimator, thinkingAnimator, pulseAnimator).forEach { it.start() }
    }

    fun setState(newState: State) {
        if (state == newState) return
        state = newState
        invalidate()
    }

    fun setAmplitude(a: Float) { amplitude = a.coerceIn(0f, 1f) }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val cx = width / 2f
        val cy = height / 2f
        val maxR = min(cx, cy)
        val (innerColor, outerColor) = palettes.getValue(state)

        val pulseAmount = if (state == State.IDLE) 1f else 0.5f
        val pulse = 1f + 0.15f * pulseAmount * sin(pulsePhase.toDouble()).toFloat()
        val coreR = maxR * 0.36f * pulse
        val glowAlpha = (120f + 100f * (sin(pulsePhase.toDouble()).toFloat() * 0.5f + 0.5f)).toInt()

        // Layer 1: Radial glow
        glowPaint.shader = RadialGradient(
            cx, cy, coreR * 1.6f,
            intArrayOf(ColorUtils.setAlphaComponent(innerColor, glowAlpha), Color.TRANSPARENT),
            floatArrayOf(0f, 1f), Shader.TileMode.CLAMP
        )
        canvas.drawCircle(cx, cy, coreR * 1.6f, glowPaint)

        // Layer 2: Core orb (sphere illusion)
        corePaint.shader = RadialGradient(
            cx - coreR * 0.3f, cy - coreR * 0.35f, coreR * 1.5f,
            intArrayOf(
                ColorUtils.blendARGB(innerColor, Color.WHITE, 0.45f),
                innerColor,
                ColorUtils.blendARGB(outerColor, Color.BLACK, 0.35f)
            ),
            floatArrayOf(0f, 0.55f, 1f), Shader.TileMode.CLAMP
        )
        canvas.drawCircle(cx, cy, coreR, corePaint)

        // Layer 3: 3 rotating dashed rings
        ringPaint.strokeWidth = 1.6f * density
        for (r in 0 until 3) {
            val radius = coreR * (1.45f + r * 0.22f)
            val dir = if (r % 2 == 0) 1f else -1f
            ringPaint.color = ColorUtils.setAlphaComponent(if (r == 1) outerColor else innerColor, 190)
            canvas.drawArc(
                cx - radius, cy - radius, cx + radius, cy + radius,
                rotationAngle * dir * (1f + r * 0.35f), 280f, false, ringPaint
            )
        }

        // Layer 4: Amplitude-reactive wave rings
        wavePaint.strokeWidth = 1.6f * density
        val phase = waveOffset * (if (state == State.SPEAKING) 2f else 1f)
        for (w in 0 until 3) {
            val base = coreR * (1.25f + w * 0.3f)
            val waveAmp = (3f + amplitude * 22f) * density
            val waveR = base + sin((phase * 2f + w * 1.1f).toDouble()).toFloat() * waveAmp
            wavePaint.color = ColorUtils.setAlphaComponent(outerColor, (170 - w * 45).coerceAtLeast(0))
            canvas.drawCircle(cx, cy, waveR, wavePaint)
        }

        // Layer 5: Thinking arcs (spinning loader)
        if (state == State.THINKING) {
            val arcR = coreR * 1.75f
            arcPaint.strokeWidth = 4f * density
            arcPaint.color = innerColor
            canvas.drawArc(cx - arcR, cy - arcR, cx + arcR, cy + arcR, thinkingAngle, 100f, false, arcPaint)
            arcPaint.color = outerColor
            canvas.drawArc(cx - arcR, cy - arcR, cx + arcR, cy + arcR, thinkingAngle + 180f, 60f, false, arcPaint)
        }

        // Layer 6: Orbiting particles
        if (state == State.SPEAKING || state == State.LISTENING) {
            particlePaint.color = ColorUtils.setAlphaComponent(
                if (state == State.SPEAKING) innerColor else outerColor, 200
            )
            for (p in particles) {
                val ang = Math.toRadians((p.angle + rotationAngle * p.speed).toDouble())
                val orbR = coreR * p.radiusFactor + amplitude * 12f * density
                val px = cx + (orbR * Math.cos(ang)).toFloat()
                val py = cy + (orbR * Math.sin(ang)).toFloat()
                canvas.drawCircle(px, py, p.size * density * (0.7f + amplitude * 0.6f), particlePaint)
            }
        }

        // Layer 7: Inner highlight
        val hx = cx - coreR * 0.35f
        val hy = cy - coreR * 0.4f
        highlightPaint.shader = RadialGradient(
            hx, hy, coreR * 0.6f,
            intArrayOf(0x59FFFFFF, 0x00FFFFFF),
            floatArrayOf(0f, 1f), Shader.TileMode.CLAMP
        )
        canvas.drawCircle(hx, hy, coreR * 0.6f, highlightPaint)
    }

    override fun onDetachedFromWindow() {
        super.onDetachedFromWindow()
        rotationAnimator.cancel(); waveAnimator.cancel()
        thinkingAnimator.cancel(); pulseAnimator.cancel()
    }
}
