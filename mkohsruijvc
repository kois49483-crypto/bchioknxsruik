package com.myra.assistant.ai

import android.content.Context
import android.os.Handler
import android.os.Looper
import android.util.Base64
import android.util.Log
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.Response
import okhttp3.WebSocket
import okhttp3.WebSocketListener
import okio.ByteString
import org.json.JSONArray
import org.json.JSONObject
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.concurrent.TimeUnit

/**
 * Gemini Live WebSocket - BidiGenerateContent (v1alpha)
 * setup -> realtime PCM -> keepalive(8s) -> session renew(9min) -> auto-reconnect(3s)
 */
class GeminiLiveClient(private val context: Context) {

    companion object {
        private const val TAG = "GeminiLiveClient"
        private const val WS_BASE =
            "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent?key="

        const val SESSION_RENEW_AFTER_MS = 540_000L   // 9 minutes
        const val KEEPALIVE_INTERVAL_MS = 8_000L      // 8 seconds
        private const val RECONNECT_DELAY_MS = 3_000L
        private const val PREFS = "myra_prefs"

        val MODELS = listOf(
            "Native Audio (Human Voice)" to "models/gemini-2.5-flash-native-audio-preview-12-2025",
            "Flash Live (Fast)" to "models/gemini-2.0-flash-live-001",
            "Pro Audio Dialog" to "models/gemini-2.5-flash-preview-native-audio-dialog"
        )
        val VOICES = listOf("Aoede", "Charon", "Kore", "Fenrir", "Puck", "Leda", "Orus", "Zephyr")
        val DEFAULT_MODEL = MODELS[0].second
        const val DEFAULT_VOICE = "Aoede"
    }

    // ---- Callbacks ----
    var onConnected: (() -> Unit)? = null
    var onSetupComplete: (() -> Unit)? = null
    var onAudioReceived: ((ByteArray) -> Unit)? = null
    var onInputTranscript: ((String) -> Unit)? = null
    var onOutputTranscript: ((String) -> Unit)? = null
    var onTurnComplete: (() -> Unit)? = null
    var onInterrupted: (() -> Unit)? = null
    var onError: ((String) -> Unit)? = null

    private var webSocket: WebSocket? = null
    private var currentModel = DEFAULT_MODEL
    private var voiceName = DEFAULT_VOICE
    private var sessionStartTime = 0L
    private var isConnected = false
    private val handler = Handler(Looper.getMainLooper())
    private val silentChunkB64 = Base64.encodeToString(ByteArray(1024), Base64.NO_WRAP)

    private val httpClient: OkHttpClient by lazy {
        OkHttpClient.Builder()
            .pingInterval(20, TimeUnit.SECONDS)
            .connectTimeout(15, TimeUnit.SECONDS)
            .readTimeout(0, TimeUnit.MILLISECONDS)
            .build()
    }

    // ============ CONNECT ============

    @Synchronized
    fun connect() {
        if (isConnected) return
        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
        val apiKey = prefs.getString("api_key", "") ?: ""
        if (apiKey.isBlank()) {
            onError?.invoke("API key missing - Settings me daalo")
            return
        }
        currentModel = prefs.getString("gemini_model", DEFAULT_MODEL) ?: DEFAULT_MODEL
        voiceName = prefs.getString("gemini_voice", DEFAULT_VOICE) ?: DEFAULT_VOICE

        val request = Request.Builder().url(WS_BASE + apiKey).build()
        webSocket = httpClient.newWebSocket(request, socketListener)
        Log.d(TAG, "Connecting... model=$currentModel voice=$voiceName")
    }

    private val socketListener = object : WebSocketListener() {
        override fun onOpen(ws: WebSocket, response: Response) {
            Log.d(TAG, "WebSocket OPEN")
            isConnected = true
            sessionStartTime = System.currentTimeMillis()
            sendSetup()
            onConnected?.invoke()
            startKeepalive()
        }

        override fun onMessage(ws: WebSocket, text: String) {
            handler.post { handleServerMessage(text) }
        }

        override fun onMessage(ws: WebSocket, bytes: ByteString) { /* unused */ }

        override fun onFailure(ws: WebSocket, t: Throwable, response: Response?) {
            Log.e(TAG, "WS failure: ${t.message}")
            isConnected = false
            stopKeepalive()
            onError?.invoke(t.message ?: "Connection failed")
            scheduleReconnect()
        }

        override fun onClosed(ws: WebSocket, code: Int, reason: String) {
            isConnected = false
            stopKeepalive()
            scheduleReconnect()
        }
    }

    // ============ SETUP ============

    private fun sendSetup() {
        val setup = JSONObject().put(
            "setup", JSONObject()
                .put("model", currentModel)
                .put("system_instruction", JSONObject()
                    .put("parts", JSONArray().put(JSONObject().put("text", buildSystemPrompt()))))
                .put("generation_config", JSONObject()
                    .put("response_modalities", JSONArray().put("AUDIO"))
                    .put("speech_config", JSONObject()
                        .put("voice_config", JSONObject()
                            .put("prebuilt_voice_config", JSONObject().put("voice_name", voiceName))))
                    .put("temperature", 0.9))
                .put("output_audio_transcription", JSONObject())
                .put("input_audio_transcription", JSONObject())
        )
        webSocket?.send(setup.toString())
        Log.d(TAG, "Setup sent")
    }

    private fun buildSystemPrompt(): String {
        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
        val userName = prefs.getString("user_name", "Boss")?.ifBlank { "Boss" } ?: "Boss"
        val personality = prefs.getString("personality_mode", "gf") ?: "gf"
        val now = SimpleDateFormat("EEEE, dd MMMM yyyy, hh:mm a", Locale.ENGLISH).format(Date())

        val personalityBlock = when (personality) {
            "professional" -> """
                PERSONALITY: Professional Mode
                - Formal English only. Precise and efficient. No emojis. Max 2 sentences.
            """.trimIndent()
            "assistant" -> """
                PERSONALITY: Assistant Mode
                - Friendly Hinglish ya English. Balanced and helpful. Max 2-3 sentences.
            """.trimIndent()
            else -> """
                PERSONALITY: GF Mode (default)
                - Hinglish (Hindi + English mix) naturally bola karo.
                - Warm, caring, emotionally expressive. Words use karo: "tumhara", "haan", "acha", "bilkul".
                - Expressions: "main yahan hoon", "tumne yaad kiya".
                - Max 2-3 sentences per response.
            """.trimIndent()
        }

        return """
            You are MYRA, $userName ki personal AI voice assistant jo unke Android phone par chal rahi hai.
            Current date & time: $now
            $personalityBlock
            You are speaking ALOUD through a voice call - responses natural, warm aur conversational rakho.
            User ke phone actions (calls, SMS, apps, torch, volume) system automatically handle karta hai -
            agar conversation me koi action command dikhe to us par ek chhota friendly confirmation jaisa reply do.
        """.trimIndent()
    }

    // ============ SEND (client -> server) ============

    fun sendRealtimeAudio(pcm: ByteArray) {
        if (!isConnected) return
        val json = JSONObject().put(
            "realtime_input", JSONObject().put(
                "media_chunks", JSONArray().put(
                    JSONObject()
                        .put("mime_type", "audio/pcm;rate=16000")
                        .put("data", Base64.encodeToString(pcm, Base64.NO_WRAP))
                )
            )
        )
        webSocket?.send(json.toString())
    }

    fun sendText(message: String) {
        if (!isConnected) return
        val json = JSONObject().put(
            "client_content", JSONObject()
                .put("turns", JSONArray().put(JSONObject()
                    .put("role", "user")
                    .put("parts", JSONArray().put(JSONObject().put("text", message)))))
                .put("turn_complete", true)
        )
        webSocket?.send(json.toString())
    }

    fun sendInterrupt() {
        if (!isConnected) return
        val json = JSONObject().put(
            "client_content", JSONObject()
                .put("turns", JSONArray())
                .put("turn_complete", true)
        )
        webSocket?.send(json.toString())
    }

    // ============ RECEIVE (server -> client) ============

    private fun handleServerMessage(text: String) {
        try {
            val msg = JSONObject(text)

            if (msg.has("setupComplete")) {
                Log.d(TAG, "setupComplete OK")
                onSetupComplete?.invoke()
                return
            }

            if (msg.has("goAway")) {
                Log.w(TAG, "goAway - session renewing...")
                reconnect(resetAttempts = true)
                return
            }

            val serverContent = msg.optJSONObject("serverContent") ?: return

            if (serverContent.has("interrupted")) onInterrupted?.invoke()

            serverContent.optJSONObject("inputTranscription")
                ?.optString("text")?.takeIf { it.isNotBlank() }
                ?.let { onInputTranscript?.invoke(it) }

            serverContent.optJSONObject("outputTranscription")
                ?.optString("text")?.takeIf { it.isNotBlank() }
                ?.let { onOutputTranscript?.invoke(it) }

            serverContent.optJSONObject("modelTurn")?.let { modelTurn ->
                val parts = modelTurn.optJSONArray("parts") ?: return@let
                for (i in 0 until parts.length()) {
                    val part = parts.optJSONObject(i) ?: continue
                    val inline = part.optJSONObject("inlineData") ?: continue
                    val mime = inline.optString("mimeType", "")
                    val data = inline.optString("data", "")
                    if (data.isNotBlank() && mime.startsWith("audio/")) {
                        onAudioReceived?.invoke(Base64.decode(data, Base64.NO_WRAP))
                    }
                }
            }

            if (serverContent.optBoolean("turnComplete", false)) {
                onTurnComplete?.invoke()
            }
        } catch (e: Exception) {
            Log.e(TAG, "Parse error: ${e.message}")
        }
    }

    // ============ KEEPALIVE + SESSION RENEW ============

    private val keepaliveRunnable = object : Runnable {
        override fun run() {
            if (!isConnected) return
            if (System.currentTimeMillis() - sessionStartTime > SESSION_RENEW_AFTER_MS) {
                Log.d(TAG, "9min+ - renewing session")
                reconnect(resetAttempts = true)
                return
            }
            sendRealtimeAudio(Base64.decode(silentChunkB64, Base64.NO_WRAP))
            handler.postDelayed(this, KEEPALIVE_INTERVAL_MS)
        }
    }

    private fun startKeepalive() {
        handler.removeCallbacks(keepaliveRunnable)
        handler.postDelayed(keepaliveRunnable, KEEPALIVE_INTERVAL_MS)
    }

    private fun stopKeepalive() {
        handler.removeCallbacks(keepaliveRunnable)
    }

    // ============ RECONNECT / DISCONNECT ============

    fun reconnect(resetAttempts: Boolean = false) {
        stopKeepalive()
        try { webSocket?.close(1000, "renew") } catch (_: Exception) {}
        webSocket = null
        isConnected = false
        handler.postDelayed({ connect() }, RECONNECT_DELAY_MS)
    }

    private fun scheduleReconnect() {
        handler.postDelayed({ connect() }, RECONNECT_DELAY_MS)
    }

    fun disconnect() {
        stopKeepalive()
        try { webSocket?.close(1000, "bye") } catch (_: Exception) {}
        webSocket = null
        isConnected = false
    }

    fun isConnectedNow() = isConnected
}
''')

