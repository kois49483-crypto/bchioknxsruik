    private fun resolveContactNumber(ctx: Context, name: String): String? {
        val clean = name.trim()
        if (clean.matches(Regex("[+0-9 ]{6,}"))) return clean.replace(" ", "")

        val projection = arrayOf(
            ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME,
            ContactsContract.CommonDataKinds.Phone.NUMBER
        )
        var partialMatch: String? = null
        val q = clean.lowercase()
        ctx.contentResolver.query(ContactsContract.CommonDataKinds.Phone.CONTENT_URI, projection, null, null, null)
            ?.use { cursor ->
                val nameIdx = cursor.getColumnIndex(ContactsContract.CommonDataKinds.Phone.DISPLAY_NAME)
                val numIdx = cursor.getColumnIndex(ContactsContract.CommonDataKinds.Phone.NUMBER)
                while (cursor.moveToNext()) {
                    val contactName = cursor.getString(nameIdx)?.lowercase() ?: continue
                    val number = cursor.getString(numIdx) ?: continue
                    if (contactName == q) return number
                    if (partialMatch == null && (contactName.contains(q) || q.contains(contactName)))
                        partialMatch = number
                }
            }
        return partialMatch
    }

    private fun makeCall(ctx: Context, target: String): String {
        if (target.isBlank()) return "Kisko call karna hai, naam batao"
        val number = resolveContactNumber(ctx, target) ?: return "Contact nahi mila: $target"
        return dialNumber(ctx, number, "Calling $target")
