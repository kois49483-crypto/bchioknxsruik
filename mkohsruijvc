        "netflix" to "com.netflix.mediaclient",
        "twitter" to "com.twitter.android",
        "telegram" to "org.telegram.messenger",
        "snapchat" to "com.snapchat.android",
        "settings" to "com.android.settings",
        "calculator" to "com.android.calculator2",
        "calendar" to "com.android.calendar",
        "clock" to "com.android.deskclock",
        "camera" to "com.android.camera2",
        "paytm" to "net.one97.paytm",
        "phonepe" to "com.phonepe.app",
        "gpay" to "com.google.android.apps.nbu.paisa.user",
        "zoom" to "us.zoom.videomeetings",
        "linkedin" to "com.linkedin.android",
        "discord" to "com.discord"
    )

    val PRIME_PET_NAMES = listOf(
        "close friend", "best friend", "bestie", "jaan", "love",
        "gf", "bf", "darling", "sweetheart", "prime contact"
    )

    fun parse(raw: String): AppCommand? {
        val t = raw.trim().lowercase()
            .replace(Regex("[!.,?]+$"), "")
            .replace(Regex("\\s+"), " ")
        if (t.length < 3) return null

        acceptReject(t)?.let { return it }
        primeCommand(t)?.let { return it }
        whatsappCommand(t)?.let { return it }
        smsCommand(t)?.let { return it }
        appCommand(t)?.let { return it }
        callCommand(t)?.let { return it }
        toggleCommand(t)?.let { return it }
        return null
    }

    // ---- Call accept / reject ----
    private fun acceptReject(t: String): AppCommand? {
        if (Regex("\\b(uthao|utha lo|utha do|pick up|accept call|receive call|phone uthao)\\b").containsMatchIn(t))
            return AppCommand(AppCommand.ACCEPT_CALL)
        if (Regex("\\b(reject|mat uthao|uthana mat|kaat do|cut karo|call cut)\\b").containsMatchIn(t))
            return AppCommand(AppCommand.REJECT_CALL)
        return null
    }

    // ---- Prime contacts ----
    private fun primeCommand(t: String): AppCommand? {
        val pet = PRIME_PET_NAMES.joinToString("|") { Regex.escape(it) }
        var index = 0
        if (Regex("\\b(second|dusra|doosra|2nd)\\b").containsMatchIn(t)) index = 1
        if (Regex("\\b(third|tisra|3rd)\\b").containsMatchIn(t)) index = 2

        val callRegex = Regex(
            "(?:call|phone|dial)[a-z ]{0,12}(?:mer[aiy] |my )?(?:$pet)" +
            "|(?:mer[aiy] |my )?(?:$pet)\\s*(?:ko)?\\s*[a-z ]{0,10}(?:call|phone)"
        )
        if (callRegex.containsMatchIn(t))
            return AppCommand(AppCommand.PRIME_CALL, mapOf("index" to index.toString()))

        val msgRegex = Regex(
            "(?:message|msg|text|sms)[a-z ]{0,12}(?:mer[aiy] |my )?(?:$pet)" +
            "|(?:mer[aiy] |my )?(?:$pet)\\s*(?:ko)?\\s*[a-z ]{0,10}(?:message|msg|text)"
        )
        if (msgRegex.containsMatchIn(t))
            return AppCommand(AppCommand.PRIME_MSG, mapOf("index" to index.toString(), "message" to extractMessage(t)))

        return null
    }

    // ---- WhatsApp ----
    private fun whatsappCommand(t: String): AppCommand? {
        if (!t.contains("whatsapp")) return null
        if (Regex("\\b(band|close|kholo|open)\\b").containsMatchIn(t)) return null

        val isCall = Regex("\\b(call|phone)\\b").containsMatchIn(t) &&
                !t.contains("message") && !t.contains("msg")

        val target = Regex(
            "(?:whatsapp)\\s*(?:pe|par|on)?\\s*(?:message|msg|call|text)?\\s*(?:karo|kar do|send)?\\s*(?:mer[aiy] |my )?([a-z ]+?)\\s*(?:ko)?\\s*$"
        ).find(t)?.groupValues?.get(1)?.trim()
            ?: Regex(
                "(?:mer[aiy] |my )?([a-z ]+?)\\s*(?:ko)?\\s*(?:whatsapp)\\s*(?:karo|pe message|par message|pe call|par call|pe msg|par msg)"
            ).find(t)?.groupValues?.get(1)?.trim()
            ?: ""

        val params = mutableMapOf("name" to target, "message" to extractMessage(t))
        if (PRIME_PET_NAMES.any { t.contains(it) }) {
            params["prime_index"] = if (Regex("\\b(second|dusra|2nd)\\b").containsMatchIn(t)) "1" else "0"
        }
        return AppCommand(if (isCall) AppCommand.WHATSAPP_CALL else AppCommand.WHATSAPP_MSG, params)
    }

    // ---- SMS ----
    private fun smsCommand(t: String): AppCommand? {
        if (!Regex("\\b(sms|text|message|msg)\\b").containsMatchIn(t)) return null
        if (t.contains("whatsapp")) return null
        if (Regex("\\b(band|close|kholo|open)\\b").containsMatchIn(t)) return null

        // Pattern A: "sms bhejo [name] ko [msg]"
        Regex(
            "(?:sms|text|message|msg)\\s*(?:bhejo|bhej do|send karo|send|karo)?\\s*(?:to\\s+)?(?:mer[aiy] |my )?([a-z]+)\\s*(?:ko)?\\s*(?:ki|that|,)?\\s*(.*)"
        ).find(t)?.let { m ->
            val name = m.groupValues[1].trim()
            if (name.isNotBlank() && name !in listOf("karo", "bhejo", "send", "please", "kar")) {
                return AppCommand(AppCommand.SMS, mapOf("name" to name, "message" to m.groupValues[2].trim()))
            }
        }
        // Pattern B: "[name] ko message karo [msg]"
        Regex(
            "([a-z]+)\\s+ko\\s+(?:sms|text|message|msg)\\s*(?:bhejo|send|karo)?\\s*(?:ki|that)?\\s*(.*)"
        ).find(t)?.let { m ->
            val name = m.groupValues[1].trim()
            if (name.isNotBlank() && name !in listOf("meri", "mera", "mere", "my")) {
                return AppCommand(AppCommand.SMS, mapOf("name" to name, "message" to m.groupValues[2].trim()))
            }
        }
        return null
    }

    // ---- Open / Close app ----
    private fun appCommand(t: String): AppCommand? {
        if (Regex("\\b(close|band karo|band kar|exit|quit)\\b").containsMatchIn(t)) {
            for ((label, pkg) in APP_KEYWORDS) {
                if (t.contains(label)) return AppCommand(AppCommand.CLOSE_APP, mapOf("app_name" to label, "package" to pkg))
            }
        }
        if (Regex("\\b(open|kholo|khol do|launch|start|chalu karo)\\b").containsMatchIn(t)) {
            for ((label, pkg) in APP_KEYWORDS) {
                if (t.contains(label)) return AppCommand(AppCommand.OPEN_APP, mapOf("app_name" to label, "package" to pkg))
            }
        }
        Regex("([a-z ]+?)\\s+(?:kholo|khol do|open karo)\\b").find(t)
            ?.groupValues?.get(1)?.trim()?.let { before ->
                for ((label, pkg) in APP_KEYWORDS) {
                    if (before.contains(label)) return AppCommand(AppCommand.OPEN_APP, mapOf("app_name" to label, "package" to pkg))
                }
            }
        return null
    }

    // ---- Call ----
    private fun callCommand(t: String): AppCommand? {
        if (!Regex("\\b(call|phone lagao|dial)\\b").containsMatchIn(t)) return null
        if (t.contains("whatsapp")) return null

        var target = Regex("([a-z0-9 +]+?)\\s*(?:ko)?\\s*(?:call|phone lagao|dial)\\b")
            .find(t)?.groupValues?.get(1)?.trim()

        if (target.isNullOrBlank() || target == "call" || target == "dial") {
            target = Regex("\\b(?:call|dial)\\s+(?:karo\\s+|kar\\s+)?(?:mer[aiy] |my )?([a-z0-9 +]+)$")
                .find(t)?.groupValues?.get(1)?.trim()
        }
        target = target
            ?.replace(Regex("^(mer[aiy]|my|mere)\\s+"), "")
            ?.replace(Regex("\\b(call|karo|kar|do|lagao|please|phone)\\b"), "")
            ?.trim()

        if (target.isNullOrBlank() || target == "me" || target == "mujhe") return null
        if (Regex("\\b(kholo|open|band|chalu|app)\\b").containsMatchIn(target)) return null
        if (target.split(" ").size > 3) return null

        return AppCommand(AppCommand.CALL, mapOf("target" to target))
    }

    // ---- Toggles ----
    private fun toggleCommand(t: String): AppCommand? {
        if (Regex("\\b(volume|awaz|awaaz|sound)\\b.*\\b(badhao|up|tez|full|increase)\\b|\\bvolume up\\b").containsMatchIn(t))
            return AppCommand(AppCommand.VOLUME_UP)
        if (Regex("\\b(volume|awaz|awaaz|sound)\\b.*\\b(kam|down|decrease)\\b|\\bvolume down\\b").containsMatchIn(t))
            return AppCommand(AppCommand.VOLUME_DOWN)

        if (Regex("\\b(torch|flashlight|flash)\\b").containsMatchIn(t)) {
            if (Regex("\\b(off|band|bujha|bujhao)\\b").containsMatchIn(t)) return AppCommand(AppCommand.FLASHLIGHT_OFF)
            return AppCommand(AppCommand.FLASHLIGHT_ON)
        }
        if (Regex("\\b(wifi|wi-fi)\\b").containsMatchIn(t)) {
            if (Regex("\\b(off|band|disable)\\b").containsMatchIn(t)) return AppCommand(AppCommand.WIFI_OFF)
            return AppCommand(AppCommand.WIFI_ON)
        }
        if (t.contains("bluetooth")) {
            if (Regex("\\b(off|band|disable)\\b").containsMatchIn(t)) return AppCommand(AppCommand.BLUETOOTH_OFF)
            return AppCommand(AppCommand.BLUETOOTH_ON)
        }
        return null
    }

    private fun extractMessage(t: String): String {
        val afterKo = t.substringAfter(" ko ", "").trim()
        return if (afterKo.isNotBlank() &&
            !afterKo.contains("call") && !afterKo.contains("message") &&
            !afterKo.contains("msg") && !afterKo.contains("karo") && !afterKo.contains("send")
        ) afterKo else ""
    }
}
