        }
    }

    private fun sendSms(ctx: Context, name: String, message: String): String {
        if (name.isBlank()) return "Kisko SMS bhejna hai?"
        val number = resolveContactNumber(ctx, name) ?: return "Contact nahi mila: $name"
        openSmsIntent(ctx, number, message)
        return if (message.isBlank()) "SMS draft ready: $name" else "SMS ready: $name"
    }

    private fun openSmsIntent(ctx: Context, number: String, message: String) {
        val intent = Intent(Intent.ACTION_SENDTO, Uri.parse("smsto:${number.replace(" ", "")}"))
        intent.putExtra("sms_body", message)
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        ctx.startActivity(intent)
    }

    // ============ WHATSAPP ============

    private fun whatsapp(ctx: Context, params: Map<String, String>, call: Boolean): String {
        val name = params["name"]?.trim().orEmpty()
        val message = params["message"].orEmpty()
        val primeIdx = params["prime_index"]?.toIntOrNull()

        val number: String = when {
            primeIdx != null -> getPrimeContacts().getOrNull(primeIdx)?.number
                ?: return "Prime contact #$primeIdx set nahi hai"
            name.isNotBlank() -> resolveContactNumber(ctx, name) ?: return "Contact nahi mila: $name"
            else -> return "Kisko WhatsApp bhejna hai?"
        }
        val digits = number.filter { it.isDigit() }.let { if (it.length == 10) "91$it" else it }
        val url = if (call) "https://wa.me/$digits"
        else "https://wa.me/$digits?text=${Uri.encode(message.ifBlank { "Hi!" })}"

        return try {
            val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            intent.setPackage("com.whatsapp")
            ctx.startActivity(intent)
            if (call) "WhatsApp khul gaya - call button daba do" else "WhatsApp message ready: $name"
        } catch (e: Exception) {
            try {
                ctx.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
                "WhatsApp khul gaya"
