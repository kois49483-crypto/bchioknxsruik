        }
    }

    // ============ PRIME CONTACTS (JSON + legacy migration) ============

    fun getPrimeContacts(): MutableList<PrimeContact> {
        val prefs = getApplication<Application>().getSharedPreferences(PREFS, Context.MODE_PRIVATE)
        val list = mutableListOf<PrimeContact>()
        val json = prefs.getString("prime_contacts_json", null)
        if (json != null) {
            try {
                val arr = JSONArray(json)
                for (i in 0 until arr.length()) {
                    val o = arr.getJSONObject(i)
                    list.add(PrimeContact(o.optString("name"), o.optString("number")))
                }
            } catch (_: Exception) {}
        } else {
            val legacyName = prefs.getString("prime_name", null)
            val legacyNumber = prefs.getString("prime_number", null)
            if (!legacyName.isNullOrBlank() && !legacyNumber.isNullOrBlank()) {
                list.add(PrimeContact(legacyName, legacyNumber))
                savePrimeContacts(list)
            }
        }
        return list
    }

    fun savePrimeContacts(contacts: List<PrimeContact>) {
        val arr = JSONArray()
        contacts.forEach { arr.put(JSONObject().put("name", it.name).put("number", it.number)) }
        getApplication<Application>().getSharedPreferences(PREFS, Context.MODE_PRIVATE)
            .edit().putString("prime_contacts_json", arr.toString()).apply()
    }

    fun addPrimeContact(name: String, number: String) {
        if (name.isBlank() || number.isBlank()) return
        val list = getPrimeContacts()
        list.add(PrimeContact(name.trim(), number.trim()))
        savePrimeContacts(list)
    }

    fun removePrimeContact(index: Int) {
        val list = getPrimeContacts()
        if (index in list.indices) {
            list.removeAt(index)
            savePrimeContacts(list)
        }
    }

    // ============ TOGGLES ============

    private fun audio() = getApplication<Application>().getSystemService(Context.AUDIO_SERVICE) as AudioManager

    private fun torch(on: Boolean): String {
        val ctx = getApplication<Application>()
        return try {
            val cm = ctx.getSystemService(Context.CAMERA_SERVICE) as CameraManager
            val cameraId = cm.cameraIdList.firstOrNull { id ->
                val chars = cm.getCameraCharacteristics(id)
                chars.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true &&
                        chars.get(CameraCharacteristics.LENS_FACING) == CameraCharacteristics.LENS_FACING_BACK
            } ?: return "Flashlight support nahi hai is phone me"
            cm.setTorchMode(cameraId, on)
            torchOn = on
            if (on) "Torch on kar di" else "Torch off kar di"
        } catch (e: Exception) {
            "Torch control fail: ${e.message}"
        }
    }

    private fun wifiPanel(): String {
        val ctx = getApplication<Application>()
        return try {
            val intent = if (Build.VERSION.SDK_INT >= 29)
                Intent(Settings.Panel.ACTION_INTERNET_CONNECTIVITY)
            else Intent(Settings.ACTION_WIFI_SETTINGS)
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ctx.startActivity(intent)
            "WiFi panel khol diya - on/off kar do"
        } catch (e: Exception) {
            "WiFi settings nahi khul payi"
        }
    }

    private fun bluetoothSettings(): String {
        val ctx = getApplication<Application>()
        return try {
            val intent = Intent(Settings.ACTION_BLUETOOTH_SETTINGS)
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            ctx.startActivity(intent)
            "Bluetooth settings khol di - on/off kar do"
        } catch (e: Exception) {
            "Bluetooth settings nahi khul payi"
        }
    }

    // ============ CALL ACCEPT / REJECT ============

    fun acceptCallNow(): Boolean = try {
        val tm = getApplication<Application>().getSystemService(Context.TELECOM_SERVICE) as TelecomManager
        if (Build.VERSION.SDK_INT >= 28) tm.acceptRingingCall() else sendHeadsetHook()
        true
    } catch (e: Exception) {
        Log.e(TAG, "acceptCall failed: ${e.message}")
        try { sendHeadsetHook(); true } catch (e2: Exception) { false }
    }

    fun rejectCallNow(): Boolean = try {
        val tm = getApplication<Application>().getSystemService(Context.TELECOM_SERVICE) as TelecomManager
        if (Build.VERSION.SDK_INT >= 28) tm.endCall() else sendHeadsetHook()
        true
    } catch (e: Exception) {
        Log.e(TAG, "rejectCall failed: ${e.message}")
        false
    }

    private fun sendHeadsetHook() {
        val am = getApplication<Application>().getSystemService(Context.AUDIO_SERVICE) as AudioManager
        am.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_HEADSETHOOK))
        am.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_UP, KeyEvent.KEYCODE_HEADSETHOOK))
    }
}
''')

